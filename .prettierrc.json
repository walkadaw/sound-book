{
  "printWidth": 120,
  "tabWidth": 2,
  "parser": "typescript",
  "semi": true,
  "bracketSpacing": true,
  "singleQuote": true,
  "overrides": [
    {
      "files": "*.component.html",
      "options": {
        "parser": "angular"
      }
    },
     {
      "files": "*.component.scss",
      "options": {
        "parser": "scss"
      }
    }
  ]
}
