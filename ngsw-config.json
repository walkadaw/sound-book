{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/index.csr.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ],
        "urls": [
          "https://fonts.gstatic.com/s/roboto/**",
          "https://fonts.gstatic.com/s/materialicons/**",
          "https://fonts.gstatic.com/s/ubuntu/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(eot|svg|cur|jpg|png|webp|gif|otf|ttf|woff|woff2|ani)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "songs",
      "urls": [
        "/api/song/get"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 4,
        "maxAge": "365d",
        "timeout": "10s"
      }
    },
    {
      "name": "liturgy",
      "urls": [
        "/api/liturgy/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 4,
        "maxAge": "1d",
        "timeout": "5s"
      }
    }
  ]
}
